// Static File Serving Example — MIME detection, traversal protection, index.html fallback

import contrib.tinyweb
import std.http
import std.string
import std.list
import std.map
import std.tcp


main() {
    println("=== TinyWeb Static File Server ===\n")

    server = tinyweb.web_server_host("localhost", 8080) {

        tinyweb.serve_static("/static", ".")

        tinyweb.end_point(tinyweb.GET, "/") |req: ptr, res: ptr, ctx: ptr| {
            tinyweb.response_set_header(res, "Content-Type", "text/html")
            tinyweb.response_write(res, "<!DOCTYPE html>
<html>
<head><title>Static File Server</title></head>
<body>
  <h1>TinyWeb Static File Server</h1>
  <p>Try these links:</p>
  <ul>
    <li><a href=\"/static/README.md\">/static/README.md</a></li>
    <li><a href=\"/static/module.ae\">/static/module.ae</a></li>
  </ul>
</body>
</html>")
        }

        tinyweb.end_point(tinyweb.GET, "/api/health") |req: ptr, res: ptr, ctx: ptr| {
            tinyweb.response_json(res, "{\"status\":\"ok\"}")
        }
    }

    http.monitor(tinyweb.http_server(server)) {
        listening() |host: string, port: int| {
            println("Server running! Try:")
            println("  http://localhost:${port}/              — index page")
            println("  http://localhost:${port}/static/...    — static files from cwd")
            println("  http://localhost:${port}/api/health    — JSON health check")
            println("\nPress Ctrl+C to stop.")
        }
    }

    println("Starting server on localhost:8080...")
    result = tinyweb.tw_start(server)
    if result != "" {
        println("ERROR: Failed to start server: ${result}")
    }

    tinyweb.tw_stop(server)
}
