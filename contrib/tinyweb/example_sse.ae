// Server-Sent Events (SSE) and chunked Example — streaming to browser clients

import contrib.tinyweb
import std.http

main() {
    println("=== TinyWeb SSE + Chunked Example ===\n")

    server = tinyweb.web_server_host("127.0.0.1", 8080) {
        tinyweb.end_point(tinyweb.GET, "/") | req: ptr, res: ptr, ctx: ptr | {
            tinyweb.response_set_header(res, "Content-Type", "text/html")
            tinyweb.response_write(res, "<!DOCTYPE html>
<html>
<head><title>TinyWeb SSE Demo</title></head>
<body>
  <h1>Server-Sent Events</h1>
  <div id=\"events\"></div>
  <script>
    var source = new EventSource('/sse/events');
    source.onmessage = function(e) {
      var div = document.getElementById('events');
      div.innerHTML += '<p>' + e.data + '</p>';
    };
    source.addEventListener('tick', function(e) {
      var div = document.getElementById('events');
      div.innerHTML += '<p><b>tick:</b> ' + e.data + '</p>';
    });
  </script>
</body>
</html>")
        }

        tinyweb.path("/sse") {
            // A tick a second until the client leaves: sse_send returns -1
            // once it has gone.
            tinyweb.sse_endpoint("/events") | stream: ptr | {
                tinyweb.sse_send(stream, "Initial event")
                n = 1
                while tinyweb.sse_send_event(stream, "tick", "${n}") == 0 {
                    if n - ((n / 15) * 15) == 0 { tinyweb.sse_comment(stream, "keep-alive") }
                    n = n + 1
                    sleep(1000)
                }
            }
        }

        // A body sent in pieces, its length unknown when the head goes out.
        tinyweb.end_point(tinyweb.GET, "/countdown") | req: ptr, res: ptr, ctx: ptr | {
            tinyweb.response_set_header(res, "Content-Type", "text/plain")
            stream, err = tinyweb.chunked_start(res, 200)
            if err == "" {
                for (i = 3; i > 0; i--) {
                    tinyweb.write_chunk(stream, "${i}...\n")
                    sleep(500)
                }
                tinyweb.write_chunk(stream, "liftoff\n")
                tinyweb.chunked_end(stream)
            }
        }
    }

    http.monitor(tinyweb.http_server(server)) {
        listening() |host: string, port: int| {
            println("Open http://localhost:${port}/ or: curl -N http://localhost:${port}/sse/events")
            println("Chunked: curl -N http://localhost:${port}/countdown")
            println("\nPress Ctrl+C to stop.")
        }
    }

    println("Starting server on localhost:8080...")
    result = tinyweb.tw_start(server)
    if result != "" {
        println("ERROR: Failed to start server: ${result}")
    }

    tinyweb.tw_stop(server)
}
