// WebSocket Example — HTTP and WebSocket routes on one port, with echo handlers

import contrib.tinyweb
import std.http

main() {
    println("=== TinyWeb WebSocket Example ===\n")

    server = tinyweb.web_server_host("127.0.0.1", 8080) {
        tinyweb.path("/foo") {
            tinyweb.end_point(tinyweb.GET, "/bar") | req: ptr, res: ptr, ctx: ptr | {
                tinyweb.response_write(res, "Hello, World!")
            }

            // Echo the message back 3 times
            tinyweb.web_socket("/eee") | msg: string, sender: ptr, ctx: ptr | {
                http.ws_send_text(sender, "Server sent: ${msg}-1")
                http.ws_send_text(sender, "Server sent: ${msg}-2")
                http.ws_send_text(sender, "Server sent: ${msg}-3")
            }
        }

        tinyweb.web_socket("/echo") | msg: string, sender: ptr, ctx: ptr | {
            http.ws_send_text(sender, "Echo: ${msg}")
        }

        tinyweb.end_point(tinyweb.GET, "/") | req: ptr, res: ptr, ctx: ptr | {
            tinyweb.response_set_header(res, "Content-Type", "text/html")
            tinyweb.response_write(res, "<!DOCTYPE html>
<html>
<head><title>TinyWeb WebSocket Demo</title></head>
<body>
  <h1>WebSocket Echo</h1>
  <input id=\"msg\" value=\"hello\">
  <button onclick=\"send()\">Send</button>
  <pre id=\"log\"></pre>
  <script>
    var ws = new WebSocket('ws://' + location.host + '/echo');
    ws.onmessage = function(e) {
      document.getElementById('log').textContent += e.data + '\\n';
    };
    function send() {
      ws.send(document.getElementById('msg').value);
    }
  </script>
</body>
</html>")
        }
    }

    http.monitor(tinyweb.http_server(server)) {
        listening() |host: string, port: int| {
            println("Open http://localhost:${port}/ in a browser for the demo page.")
            println("  ws://localhost:${port}/echo     — simple echo")
            println("  ws://localhost:${port}/foo/eee  — echo x3")
            println("\nPress Ctrl+C to stop.")
        }
    }

    println("Starting server on localhost:8080...")
    result = tinyweb.tw_start(server)
    if result != "" {
        println("ERROR: Failed to start server: ${result}")
    }

    tinyweb.tw_stop(server)
    println("Server stopped.")
}
