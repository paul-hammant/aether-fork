// std.clapae - command line argument parser inspired by Rust's clap
// Import with: import std.clapae

exports (
    command, arg, subcommand, about, short, `long`, help, takes_value, required, is_flag,
    parse, parse_list, get_one, get_flag, subcommand_name, subcommand_matches,
    free_command, free_matches,
    Command, Arg, ArgMatches
)

import std.list
import std.map
import std.string (*)
import std.os (*)

struct Arg {
    name: string
    short_char: int
    long_name: string
    help_text: string
    takes_value: int
    required: int
    is_flag: int
}

struct Command {
    name: string
    about_text: string
    args: ptr          // std.list of *Arg
    subcommands: ptr   // std.list of *Command
}

struct ArgMatches {
    command_name: string
    values: ptr             // std.map of string -> string
    flags: ptr              // std.map of string -> int
    subcommand: ptr         // *ArgMatches of matched subcommand, or null
}

arg_new() -> *Arg {
    a = heap.new(Arg)
    a.name = ""
    a.short_char = 0
    a.long_name = ""
    a.help_text = ""
    a.takes_value = 0
    a.required = 0
    a.is_flag = 0
    return a
}

command_new() -> *Command {
    c = heap.new(Command)
    c.name = ""
    c.about_text = ""
    c.args = list_new()
    c.subcommands = list_new()
    return c
}

arg_matches_new(cmd_name: string) -> *ArgMatches {
    m = heap.new(ArgMatches)
    m.command_name = cmd_name
    m.values = map_new()
    m.flags = map_new()
    m.subcommand = null
    return m
}

// --- Builder DSL functions ---

builder command(name: string): *Command with command_new {
    if _builder != null {
        c = _builder as *Command
        c.name = name
    }
    return _builder as *Command
}

builder arg(name: string): *Arg with arg_new {
    if _builder != null {
        a = _builder as *Arg
        a.name = name

        parent = builder_context()
        if parent != null {
            parent_cmd = parent as *Command
            list_add_raw(parent_cmd.args, a)
        }
    }
    return _builder as *Arg
}

builder subcommand(name: string): *Command with command_new {
    if _builder != null {
        c = _builder as *Command
        c.name = name

        parent = builder_context()
        if parent != null {
            parent_cmd = parent as *Command
            list_add_raw(parent_cmd.subcommands, c)
        }
    }
    return _builder as *Command
}

// --- Setter functions for configuration ---

about(_ctx: ptr, text: string) {
    if _ctx != null {
        c = _ctx as *Command
        c.about_text = text
    }
}

short(_ctx: ptr, c: int) {
    if _ctx != null {
        a = _ctx as *Arg
        a.short_char = c
    }
}

`long`(_ctx: ptr, name: string) {
    if _ctx != null {
        a = _ctx as *Arg
        a.long_name = name
    }
}

help(_ctx: ptr, text: string) {
    if _ctx != null {
        a = _ctx as *Arg
        a.help_text = text
    }
}

takes_value(_ctx: ptr, val: int) {
    if _ctx != null {
        a = _ctx as *Arg
        a.takes_value = val
    }
}

required(_ctx: ptr, val: int) {
    if _ctx != null {
        a = _ctx as *Arg
        a.required = val
    }
}

is_flag(_ctx: ptr, val: int) {
    if _ctx != null {
        a = _ctx as *Arg
        a.is_flag = val
    }
}

// --- Cleanup functions ---

free_command(c: *Command) {
    if c == null { return }
    if c.args != null {
        n = list_size(c.args)
        for (i = 0; i < n; i++) {
            a = list_get_raw(c.args, i) as *Arg
            if a != null {
                heap.free(a)
            }
        }
        list_free(c.args)
    }
    if c.subcommands != null {
        n = list_size(c.subcommands)
        for (i = 0; i < n; i++) {
            sub = list_get_raw(c.subcommands, i) as *Command
            free_command(sub)
        }
        list_free(c.subcommands)
    }
    heap.free(c)
}

free_matches(m: *ArgMatches) {
    if m == null { return }
    if m.values != null {
        map_free(m.values)
    }
    if m.flags != null {
        map_free(m.flags)
    }
    if m.subcommand != null {
        free_matches(m.subcommand as *ArgMatches)
    }
    heap.free(m)
}

// --- Helper search functions ---

find_arg_by_long(cmd: *Command, name: string) -> *Arg {
    n = list_size(cmd.args)
    for (i = 0; i < n; i++) {
        a = list_get_raw(cmd.args, i) as *Arg
        if string_equals(a.long_name, name) == 1 {
            return a
        }
    }
    return null
}

find_arg_by_short(cmd: *Command, sh_char: int) -> *Arg {
    n = list_size(cmd.args)
    for (i = 0; i < n; i++) {
        a = list_get_raw(cmd.args, i) as *Arg
        if a.short_char == sh_char {
            return a
        }
    }
    return null
}

find_positional_arg(cmd: *Command, idx: int) -> *Arg {
    pos_count = 0
    n = list_size(cmd.args)
    for (i = 0; i < n; i++) {
        a = list_get_raw(cmd.args, i) as *Arg
        if a.short_char == 0 && string_equals(a.long_name, "") == 1 {
            if pos_count == idx {
                return a
            }
            pos_count = pos_count + 1
        }
    }
    return null
}

find_subcommand(cmd: *Command, name: string) -> *Command {
    n = list_size(cmd.subcommands)
    for (i = 0; i < n; i++) {
        sub = list_get_raw(cmd.subcommands, i) as *Command
        if string_equals(sub.name, name) == 1 {
            return sub
        }
    }
    return null
}

// --- Parsing logic ---

print_help(cmd: *Command) {
    print("Usage: ")
    print(cmd.name)

    has_options = 0
    has_positionals = 0

    n_args = list_size(cmd.args)
    for (i = 0; i < n_args; i++) {
        a = list_get_raw(cmd.args, i) as *Arg
        if a.short_char != 0 || string_equals(a.long_name, "") != 1 {
            has_options = 1
        } else {
            has_positionals = 1
        }
    }

    if has_options == 1 {
        print(" [OPTIONS]")
    }

    // Print positionals in usage
    for (i = 0; i < n_args; i++) {
        a = list_get_raw(cmd.args, i) as *Arg
        if a.short_char == 0 && string_equals(a.long_name, "") == 1 {
            if a.required == 1 {
                print(" <")
                print(a.name)
                print(">")
            } else {
                print(" [")
                print(a.name)
                print("]")
            }
        }
    }

    if list_size(cmd.subcommands) > 0 {
        print(" [COMMAND]")
    }
    print("\n\n")

    if string_equals(cmd.about_text, "") != 1 {
        println(cmd.about_text)
        println("")
    }

    // Print Options and Flags
    if has_options == 1 {
        println("Options:")
        for (i = 0; i < n_args; i++) {
            a = list_get_raw(cmd.args, i) as *Arg
            if a.short_char != 0 || string_equals(a.long_name, "") != 1 {
                print("  ")
                if a.short_char != 0 {
                    print("-")
                    print(string_from_char(a.short_char))
                } else {
                    print("  ")
                }
                if string_equals(a.long_name, "") != 1 {
                    if a.short_char != 0 {
                        print(", ")
                    }
                    print("--")
                    print(a.long_name)
                }

                if a.takes_value == 1 {
                    print(" <VALUE>")
                }

                print("\t")
                println(a.help_text)
            }
        }
        println("  -h, --help\tPrint help")
        println("")
    }

    // Print Subcommands
    n_subs = list_size(cmd.subcommands)
    if n_subs > 0 {
        println("Commands:")
        for (i = 0; i < n_subs; i++) {
            sub = list_get_raw(cmd.subcommands, i) as *Command
            print("  ")
            print(sub.name)
            if string_equals(sub.about_text, "") != 1 {
                print("\t")
                print(sub.about_text)
            }
            print("\n")
        }
        println("")
    }
}

parse(cmd: *Command) -> ptr! {
    argv = list_new()
    cnt = args_count()
    for (i = 1; i < cnt; i++) {
        list_add_raw(argv, args_get(i))
    }
    matches, err = parse_list(cmd, argv)
    list_free(argv)
    if err != "" {
        return null, err
    }
    return matches, ""
}

parse_list(cmd: *Command, argv: ptr) -> ptr! {
    return parse_list_internal(cmd, argv)
}

parse_list_internal(cmd: *Command, argv: ptr) -> ptr! {
    m = arg_matches_new(cmd.name)
    pos_idx = 0
    n_argv = list_size(argv)

    i = 0
    while i < n_argv {
        arg_str = list_get_raw(argv, i)

        if string_equals(arg_str, "-h") == 1 || string_equals(arg_str, "--help") == 1 {
            print_help(cmd)
            exit(0)
        }

        if string_starts_with(arg_str, "--") == 1 {
            // Long option/flag
            eq_idx = string_index_of(arg_str, "=")
            if eq_idx != -1 {
                long_name = string_substring(arg_str, 2, eq_idx)
                val = string_substring(arg_str, eq_idx + 1, string_length(arg_str))
                a = find_arg_by_long(cmd, long_name)
                if a != null {
                    map_put(m.values, a.name, copy(val))
                } else {
                    free_matches(m)
                    return null, string_concat("unknown option: --", long_name)
                }
            } else {
                long_name = string_substring(arg_str, 2, string_length(arg_str))
                a = find_arg_by_long(cmd, long_name)
                if a != null {
                    if a.takes_value == 1 {
                        if i + 1 < n_argv {
                            val = list_get_raw(argv, i + 1)
                            map_put(m.values, a.name, copy(val))
                            i = i + 1
                        } else {
                            free_matches(m)
                            return null, string_concat("option requires value: --", long_name)
                        }
                    } else {
                        map_put(m.flags, a.name, a)
                    }
                } else {
                    free_matches(m)
                    return null, string_concat("unknown option: --", long_name)
                }
            }
        } else if string_starts_with(arg_str, "-") == 1 && string_equals(arg_str, "-") != 1 {
            // Short option/flag
            if string_length(arg_str) == 2 {
                sh_char = string_char_at(arg_str, 1)
                a = find_arg_by_short(cmd, sh_char)
                if a != null {
                    if a.takes_value == 1 {
                        if i + 1 < n_argv {
                            val = list_get_raw(argv, i + 1)
                            map_put(m.values, a.name, copy(val))
                            i = i + 1
                        } else {
                            free_matches(m)
                            return null, string_concat("option requires value: -", string_from_char(sh_char))
                        }
                    } else {
                        map_put(m.flags, a.name, a)
                    }
                } else {
                    free_matches(m)
                    return null, string_concat("unknown option: -", string_from_char(sh_char))
                }
            } else {
                // Compound flag or inline value (e.g., -cFILE or -dl)
                sh_char = string_char_at(arg_str, 1)
                a = find_arg_by_short(cmd, sh_char)
                if a != null {
                    if a.takes_value == 1 {
                        val = string_substring(arg_str, 2, string_length(arg_str))
                        map_put(m.values, a.name, copy(val))
                    } else {
                        len = string_length(arg_str)
                        for (j = 1; j < len; j++) {
                            ch = string_char_at(arg_str, j)
                            flag_arg = find_arg_by_short(cmd, ch)
                            if flag_arg != null {
                                map_put(m.flags, flag_arg.name, flag_arg)
                            } else {
                                free_matches(m)
                                return null, string_concat("unknown short option: -", string_from_char(ch))
                            }
                        }
                    }
                } else {
                    free_matches(m)
                    return null, string_concat("unknown option: -", string_from_char(sh_char))
                }
            }
        } else {
            // Positional argument or subcommand
            sub = find_subcommand(cmd, arg_str)
            if sub != null {
                sub_argv = list_new()
                for (k = i + 1; k < n_argv; k++) {
                    list_add_raw(sub_argv, list_get_raw(argv, k))
                }
                sub_matches, sub_err = parse_list_internal(sub, sub_argv)
                list_free(sub_argv)
                if sub_err != "" {
                    free_matches(m)
                    return null, sub_err
                }
                m.subcommand = sub_matches as ptr
                break
            } else {
                // Positional
                a = find_positional_arg(cmd, pos_idx)
                if a != null {
                    map_put(m.values, a.name, copy(arg_str))
                    pos_idx = pos_idx + 1
                } else {
                    free_matches(m)
                    return null, string_concat("unexpected positional argument: ", arg_str)
                }
            }
        }
        i = i + 1
    }

    // Verify required options/flags/positional args
    n_args = list_size(cmd.args)
    for (k = 0; k < n_args; k++) {
        a = list_get_raw(cmd.args, k) as *Arg
        if a.required == 1 {
            has_val = map_has(m.values, a.name)
            has_flag = map_has(m.flags, a.name)
            if has_val == 0 && has_flag == 0 {
                free_matches(m)
                return null, string_concat("required argument missing: ", a.name)
            }
        }
    }

    return m, ""
}

// --- Value extraction ---

get_one(m: ptr, name: string) -> string {
    if m == null { return "" }
    matches = m as *ArgMatches
    v = map_get_raw(matches.values, name)
    if v == null { return "" }
    return v
}

get_flag(m: ptr, name: string) -> int {
    if m == null { return 0 }
    matches = m as *ArgMatches
    if map_has(matches.flags, name) == 1 {
        return 1
    }
    return 0
}

subcommand_name(m: ptr) -> string {
    if m == null { return "" }
    matches = m as *ArgMatches
    if matches.subcommand == null { return "" }
    sub = matches.subcommand as *ArgMatches
    return sub.command_name
}

subcommand_matches(m: ptr, name: string) -> *ArgMatches {
    if m == null { return null }
    matches = m as *ArgMatches
    if matches.subcommand == null { return null }
    sub = matches.subcommand as *ArgMatches
    if string_equals(sub.command_name, name) == 1 {
        return sub
    }
    return null
}
