// std.cryptography.ascon — ASCON v1.2 Hash and HashA in pure Aether,
// ported from Bouncy Castle's AsconDigest. NO externs to OpenSSL
// or any C crypto.
//
// ASCON-Hash and ASCON-HashA are lightweight cryptographic hash functions.
//
// Import with:  import std.cryptography.ascon

import std.bits
import std.bytes

extern malloc(size: int) -> ptr
extern free(p: ptr)
extern string_char_at_n(str: string, known_length: int, index: int) -> int

exports (
    new, update, update_bytes, final_hex, final_bytes, free_ctx,
    ascon_hash_hex, ascon_hash_bytes, ascon_hasha_hex, ascon_hasha_bytes
)

struct AsconCtx {
    x0: long
    x1: long
    x2: long
    x3: long
    x4: long
    buf: ptr          // std.bytes buffer of size 8
    buf_pos: int
    pb_rounds: int    // 12 for Ascon-Hash, 8 for Ascon-HashA
    variant: string   // "ascon-hash" or "ascon-hasha"
}

pack_be64(b: ptr, off: int) -> long {
    return ((bytes.get(b, off) as long) << 56) |
           ((bytes.get(b, off + 1) as long) << 48) |
           ((bytes.get(b, off + 2) as long) << 40) |
           ((bytes.get(b, off + 3) as long) << 32) |
           ((bytes.get(b, off + 4) as long) << 24) |
           ((bytes.get(b, off + 5) as long) << 16) |
           ((bytes.get(b, off + 6) as long) << 8) |
           (bytes.get(b, off + 7) as long)
}

unpack_be64(v: long, b: ptr, off: int) {
    bytes.set(b, off, (bits.lsr64(v, 56) & 255) as int)
    bytes.set(b, off + 1, (bits.lsr64(v, 48) & 255) as int)
    bytes.set(b, off + 2, (bits.lsr64(v, 40) & 255) as int)
    bytes.set(b, off + 3, (bits.lsr64(v, 32) & 255) as int)
    bytes.set(b, off + 4, (bits.lsr64(v, 24) & 255) as int)
    bytes.set(b, off + 5, (bits.lsr64(v, 16) & 255) as int)
    bytes.set(b, off + 6, (bits.lsr64(v, 8) & 255) as int)
    bytes.set(b, off + 7, (v & 255) as int)
}

round_ascon(c: *AsconCtx, rconst: long) {
    t0 = c.x0 ^ c.x1 ^ c.x2 ^ c.x3 ^ rconst ^ (c.x1 & (c.x0 ^ c.x2 ^ c.x4 ^ rconst))
    t1 = c.x0 ^ c.x2 ^ c.x3 ^ c.x4 ^ rconst ^ ((c.x1 ^ c.x2 ^ rconst) & (c.x1 ^ c.x3))
    t2 = c.x1 ^ c.x2 ^ c.x4 ^ rconst ^ (c.x3 & c.x4)
    t3 = c.x0 ^ c.x1 ^ c.x2 ^ rconst ^ ((~c.x0) & (c.x3 ^ c.x4))
    t4 = c.x1 ^ c.x3 ^ c.x4 ^ ((c.x0 ^ c.x4) & c.x1)

    c.x0 = t0 ^ bits.rotr64(t0, 19) ^ bits.rotr64(t0, 28)
    c.x1 = t1 ^ bits.rotr64(t1, 39) ^ bits.rotr64(t1, 61)
    c.x2 = ~(t2 ^ bits.rotr64(t2, 1) ^ bits.rotr64(t2, 6))
    c.x3 = t3 ^ bits.rotr64(t3, 10) ^ bits.rotr64(t3, 17)
    c.x4 = t4 ^ bits.rotr64(t4, 7) ^ bits.rotr64(t4, 41)
}

p_perm(c: *AsconCtx, nr: int) {
    if nr == 12 {
        round_ascon(c, 0xf0)
        round_ascon(c, 0xe1)
        round_ascon(c, 0xd2)
        round_ascon(c, 0xc3)
    }
    round_ascon(c, 0xb4)
    round_ascon(c, 0xa5)
    round_ascon(c, 0x96)
    round_ascon(c, 0x87)
    round_ascon(c, 0x78)
    round_ascon(c, 0x69)
    round_ascon(c, 0x5a)
    round_ascon(c, 0x4b)
}

reset_ctx(c: *AsconCtx) {
    c.buf_pos = 0
    i = 0
    while i < 8 {
        bytes.set(c.buf, i, 0)
        i = i + 1
    }

    if c.variant == "ascon-hasha" {
        c.x0 = 0x01470194fc6528a6
        c.x1 = 0x738ec38ac0adffa7
        c.x2 = 0x2ec8e3296c76384c
        c.x3 = 0xd6f6a54d7f52377d
        c.x4 = 0xa13c42a223be8d87
        c.pb_rounds = 8
    } else {
        c.x0 = 0xee9398aadb67f03d
        c.x1 = 0x8bb21831c60f1002
        c.x2 = 0xb48a92db98d5da62
        c.x3 = 0x43189921b8f8e3e8
        c.x4 = 0x348fa5c9d525e140
        c.pb_rounds = 12
    }
}

new(variant: string) -> {
    c = malloc(80) as *AsconCtx
    if c == null {
        return null, "allocation failed"
    }
    c.buf = bytes.new(8)
    if variant == "ascon-hasha" {
        c.variant = "ascon-hasha"
    } else {
        c.variant = "ascon-hash"
    }
    reset_ctx(c)
    return c, ""
}

update_byte(c: *AsconCtx, b: int) {
    bytes.set(c.buf, c.buf_pos, b & 255)
    c.buf_pos = c.buf_pos + 1
    if c.buf_pos == 8 {
        c.x0 = c.x0 ^ pack_be64(c.buf, 0)
        p_perm(c, c.pb_rounds)
        // Reset buffer
        i = 0
        while i < 8 {
            bytes.set(c.buf, i, 0)
            i = i + 1
        }
        c.buf_pos = 0
    }
}

update(ctx: ptr, data: string, length: int) {
    c = ctx as *AsconCtx
    if length <= 0 {
        return
    }
    i = 0
    while i < length {
        update_byte(c, string_char_at_n(data, length, i))
        i = i + 1
    }
}

update_bytes(ctx: ptr, data: ptr, length: int) {
    c = ctx as *AsconCtx
    if length <= 0 {
        return
    }
    i = 0
    while i < length {
        update_byte(c, bytes.get(data, i))
        i = i + 1
    }
}

finalize_to_bytes(c: *AsconCtx) -> ptr {
    bytes.set(c.buf, c.buf_pos, 0x80)
    c.x0 = c.x0 ^ pack_be64(c.buf, 0)
    p_perm(c, 12)

    out = bytes.new(32)
    unpack_be64(c.x0, out, 0)
    p_perm(c, c.pb_rounds)
    unpack_be64(c.x0, out, 8)
    p_perm(c, c.pb_rounds)
    unpack_be64(c.x0, out, 16)
    p_perm(c, c.pb_rounds)
    unpack_be64(c.x0, out, 24)

    return out
}

free_internals(c: *AsconCtx) {
    if c.buf != null {
        bytes.free(c.buf)
        c.buf = null
    }
}

final_bytes(ctx: ptr) -> ptr {
    c = ctx as *AsconCtx
    out = finalize_to_bytes(c)
    s = bytes.finish(out, 32)
    free_internals(c)
    free(ctx)
    res = bytes.new(32)
    bytes.copy_from_string(res, 0, s, 32)
    return res
}

final_hex(ctx: ptr) -> string {
    c = ctx as *AsconCtx
    out = finalize_to_bytes(c)
    hexbuf = bytes.new(64)
    i = 0
    while i < 32 {
        b = bytes.get(out, i)
        hi = (b >> 4) & 15
        lo = b & 15
        c_hi = 48 + hi
        if hi >= 10 {
            c_hi = 87 + hi
        }
        c_lo = 48 + lo
        if lo >= 10 {
            c_lo = 87 + lo
        }
        bytes.set(hexbuf, i * 2, c_hi)
        bytes.set(hexbuf, i * 2 + 1, c_lo)
        i = i + 1
    }
    bytes.free(out)
    s = bytes.finish(hexbuf, 64)
    free_internals(c)
    free(ctx)
    return s
}

free_ctx(ctx: ptr) {
    if ctx == null {
        return
    }
    c = ctx as *AsconCtx
    free_internals(c)
    free(ctx)
}

// One-shot wrappers
ascon_hash_hex(data: string, len: int) -> string {
    ctx, err = new("ascon-hash")
    if err != "" {
        return ""
    }
    update(ctx, data, len)
    return final_hex(ctx)
}

ascon_hash_bytes(data: string, len: int) -> ptr {
    ctx, err = new("ascon-hash")
    if err != "" {
        return null
    }
    update(ctx, data, len)
    return final_bytes(ctx)
}

ascon_hasha_hex(data: string, len: int) -> string {
    ctx, err = new("ascon-hasha")
    if err != "" {
        return ""
    }
    update(ctx, data, len)
    return final_hex(ctx)
}

ascon_hasha_bytes(data: string, len: int) -> ptr {
    ctx, err = new("ascon-hasha")
    if err != "" {
        return null
    }
    update(ctx, data, len)
    return final_bytes(ctx)
}